# 本地调试示例：复制为 ostool-server/.env，再替换占位值；不要把真实凭据提交 Git。
# 入口：scripts/dev.sh start。使用同一 release 程序，不绕过登录、权限或人机验证。
# 必改：数据库密码（两处保持一致）、主加密密钥和管理员密码。
# 密码可用 openssl rand -hex 24 生成；主密钥用 openssl rand -base64 32 生成并保留。
# dev.sh 与 deploy.sh docker 仍使用同一个 Compose 项目，不要同时管理同一环境。

# 默认 public，便于调试登录、注册、密码找回与权限；免登录设备调试可改为 local 和 HTTP 来源。
OSTOOL_EDITION=public
OSTOOL_LISTEN_ADDR=127.0.0.1:3999
# 直接运行二进制时相对本文件目录；Docker 会使用容器内持久数据卷路径覆盖此项。
OSTOOL_DATA_DIR=.ostool-server-dev

# 本机无需配置 DNS；使用独立 HTTPS 调试端口，避免占用正式 Caddy 的 443。
OSTOOL_PUBLIC_BASE_URL=https://localhost:8443
OSTOOL_ALLOWED_ORIGINS=https://127.0.0.1:8443
OSTOOL_TRUSTED_PROXY_IPS=127.0.0.1,::1
# 首次启动后用 scripts/dev.sh cert 导出内部 CA，并在浏览器/CLI 所在机器信任它。
# 局域网调试时将 PUBLIC_BASE_URL 改为本机实际 IP/域名的 HTTPS 来源，按需保留本地来源。
# localhost 在其他机器上指向其自身，不能作为远程 CLI 获取的访问地址。

# Docker 自动启动数据库和缓存；端口与部署示例区分。已有数据卷需使用其原数据库密码。
OSTOOL_POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
OSTOOL_POSTGRES_PORT=54339
OSTOOL_DATABASE_URL=postgres://ostool:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:54339/ostool
OSTOOL_DATABASE_SCHEMA=ostool_dev
OSTOOL_REDIS_PORT=56390
OSTOOL_REDIS_URL=redis://127.0.0.1:56390/0
OSTOOL_REDIS_PREFIX=ostool_dev

# 填写随机 32 字节的 base64 编码；修改会导致已有加密凭据和 MFA 数据无法解密。
OSTOOL_MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
OSTOOL_ADMIN_USERNAME=admin
OSTOOL_ADMIN_EMAIL=admin@example.test
OSTOOL_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
# 初次创建后可删除管理员初始化值；不会覆盖已有账号的密码。

# 默认不监听真实设备网；需要硬件联调时显式启用并填写设备内网地址。
OSTOOL_LOADER_NETWORK_ENABLED=false
# v7 UDP 发现协议固定使用 2998，不能随调试 HTTP 端口修改。
OSTOOL_LOADER_BIND_ADDR=0.0.0.0:2998
OSTOOL_HTTP_BOOT_ENABLED=false
# OSTOOL_HTTP_BOOT_LISTEN_ADDR=192.168.10.2:4001
# OSTOOL_HTTP_BOOT_BASE_URL=http://192.168.10.2:4001
OSTOOL_NETWORK_TEST_ENABLED=false
# 启用吞吐测试时保持 Caddy 中 /v1/tests 的上游端口一致。
# OSTOOL_NETWORK_TEST_LISTEN_ADDR=127.0.0.1:3000
# OSTOOL_NETWORK_TEST_MAX_ACTIVE=64
# OSTOOL_NETWORK_TEST_MAX_DURATION_SECS=3600
# Docker 串口联调：添加 deploy/compose.serial.yaml，填写实际设备及属组数字 ID。
# OSTOOL_SERIAL_DEVICE=/dev/ttyUSB0
# OSTOOL_SERIAL_GID=20

# 启动后在后台配置业务功能。测试验证码注册时开启“注册要求邮箱验证”和“本地调试注册码”，
# 再到“邮件服务 → 邮件投递记录”查看有效注册码，无需 SMTP；找回密码仍需配置邮件服务。
# 邮件、人机验证、限流、网络接口、TFTP、审计保留等不放在启动环境中。
