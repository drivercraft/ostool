# 正式部署示例：复制为 ostool-server/.env，再替换占位值；不要把真实凭据提交 Git。
# 入口：scripts/deploy.sh docker up，或 systemd up（需已有 PostgreSQL、Redis、Caddy）。
# 必改：数据库密码（两处保持一致）、主加密密钥、管理员密码、站点域名和管理员邮箱。
# 可用 openssl rand -hex 24 生成 URL 安全的密码；主密钥用 openssl rand -base64 32 生成并备份。

OSTOOL_EDITION=public
OSTOOL_LISTEN_ADDR=127.0.0.1:2999
OSTOOL_DATA_DIR=/var/lib/ostool-server

# 域名应解析到部署服务器；接入现有 Caddy，由 Caddy 管理 HTTPS 证书。
OSTOOL_PUBLIC_BASE_URL=https://boards.example.com
# 仅存在其他真实访问来源时添加，包含协议和端口，不添加路径。
# OSTOOL_ALLOWED_ORIGINS=https://console.example.com
# 下列地址表示同机代理；异机代理填写实际、可信的代理 IP。
OSTOOL_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Docker 使用内置 PostgreSQL/Redis 和回环映射端口；systemd 部署改为实际连接地址。
# 使用已有数据卷时保持原数据库密码，修改初始化变量不会重置数据库密码。
OSTOOL_POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
OSTOOL_POSTGRES_PORT=54329
OSTOOL_DATABASE_URL=postgres://ostool:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:54329/ostool
OSTOOL_REDIS_PORT=56380
OSTOOL_REDIS_URL=redis://127.0.0.1:56380/0
OSTOOL_REDIS_PREFIX=ostool
# OSTOOL_DATABASE_SCHEMA=public

# 加密业务凭据与 MFA 种子的根密钥，填写 base64 编码的随机 32 字节；后续部署保持同一密钥。
OSTOOL_MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# 只创建缺失的管理员，已有账号不会被覆盖；创建后可删除这些初始化值。
OSTOOL_ADMIN_USERNAME=admin
OSTOOL_ADMIN_EMAIL=admin@example.com
OSTOOL_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# 独立设备监听器默认关闭；按需填写实际设备内网地址，不要暴露到公网。
OSTOOL_LOADER_NETWORK_ENABLED=false
OSTOOL_LOADER_BIND_ADDR=0.0.0.0:2998
OSTOOL_HTTP_BOOT_ENABLED=false
# OSTOOL_HTTP_BOOT_LISTEN_ADDR=192.168.10.2:3001
# OSTOOL_HTTP_BOOT_BASE_URL=http://192.168.10.2:3001
OSTOOL_NETWORK_TEST_ENABLED=false
# 吞吐测试通过现有 Caddy 转发 /v1/tests，启用前确认其上游端口匹配。
# OSTOOL_NETWORK_TEST_LISTEN_ADDR=127.0.0.1:3000
# OSTOOL_NETWORK_TEST_MAX_ACTIVE=64
# OSTOOL_NETWORK_TEST_MAX_DURATION_SECS=3600

# Docker 挂载真实串口时添加 --compose-file ostool-server/deploy/compose.serial.yaml。
# OSTOOL_SERIAL_DEVICE=/dev/ttyUSB0
# OSTOOL_SERIAL_GID=20

# 邮件、人机验证、注册、限流、调试注册码、审计保留、网络接口、TFTP 均在后台系统设置中管理。
# 敏感业务凭据加密入库，只显示配置状态；.env 仅保存启动依赖。
