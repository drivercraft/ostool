{
	https_port {$OSTOOL_HTTPS_PORT:3443}
	admin off
	auto_https disable_redirects
	skip_install_trust
}

# 私有 IP/localhost 自动使用内部 CA；正式域名自动申请公网证书。
{$OSTOOL_SITE_ADDRESSES:https://127.0.0.1 https://localhost} {
	# 与公网部署一致，硬件启动路径不通过网站入口开放。
	@hardware path /api/v1/loaders/* /api/v1/loader-updates/* /boot/* /share/*
	respond @hardware 404
	bind {$OSTOOL_HTTPS_BIND:0.0.0.0}
	reverse_proxy {$OSTOOL_UPSTREAM:127.0.0.1:2999}
}
