# 独立管理本站代理，不覆盖系统已有的 caddy.service 或其他站点配置。
[Unit]
Description=OSTool HTTPS Proxy
After=network-online.target ostool-server.service
Wants=network-online.target

[Service]
Type=simple
User=ostool-caddy
Group=ostool-caddy
Environment=XDG_DATA_HOME=/var/lib/ostool-server-proxy
Environment=XDG_CONFIG_HOME=/var/lib/ostool-server-proxy
ExecStart=/usr/bin/env caddy run --config /etc/ostool-server-proxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ostool-server-proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
