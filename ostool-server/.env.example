# Runtime configuration. Copy to .env (ignored by Git) or use --env-file.
# The frontend uses same-origin requests; no secrets or domain are built into JS.
OSTOOL_DATABASE_URL=postgres://ostool:change-me@127.0.0.1:5432/ostool
OSTOOL_DATABASE_MAX_CONNECTIONS=10
OSTOOL_DATABASE_MIGRATE=true
OSTOOL_LISTEN_ADDR=127.0.0.1:2999
OSTOOL_AUTH_ENABLED=true
OSTOOL_ALLOW_REGISTRATION=true
OSTOOL_PUBLIC_BASE_URL=https://boards.example.com
OSTOOL_ACCESS_TOKEN_TTL_SECS=900
OSTOOL_REFRESH_TOKEN_TTL_SECS=2592000
OSTOOL_DEVICE_CODE_TTL_SECS=600
OSTOOL_NETWORK_TEST_ENABLED=false
# Used only to create an administrator if this email does not exist.
# Remove the bootstrap password after initialization.
OSTOOL_ADMIN_EMAIL=admin@example.com
OSTOOL_ADMIN_PASSWORD=replace-with-a-long-random-password
