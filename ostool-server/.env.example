# 默认使用本地版，不提供账号、登录或租赁管理功能。
# 前端从 Rust 服务器读取运行时版本配置，与后端保持一致。
OSTOOL_EDITION=local
# 仅用于直接启动服务器；dev.sh 使用下方的 OSTOOL_DEV_HOST 和 OSTOOL_DEV_SERVER_PORT。
OSTOOL_LISTEN_ADDR=127.0.0.1:2999
OSTOOL_NETWORK_TEST_ENABLED=false
# 两个版本均使用 PostgreSQL，连接数据库不会启用本地版的身份认证。
OSTOOL_DATABASE_URL=postgres://ostool:change-me@127.0.0.1:5432/ostool
# 可选数据库模式；两个版本使用相同值即可共享数据，留空时使用默认搜索路径。
# OSTOOL_DATABASE_SCHEMA=ostool
# 需要身份认证的公网部署请使用 deploy/public.env.example。
# 默认值 0 表示永久保留审计事件；设为 1..3650 表示保留天数，每小时清理过期记录。
OSTOOL_AUDIT_RETENTION_DAYS=0
# 仅接受明确配置为可信代理的来源提供的 X-Forwarded-For 转发链。
# 同机 Caddy 反向代理可设置为：127.0.0.1,::1
OSTOOL_TRUSTED_PROXY_IPS=
# 本地版不需要验证码、双重验证、SMTP 或身份与租赁配置。
# 公网配置（含可选邮箱验证）的说明见：
# deploy/public.env.example 和 deploy/security.md

# 本地版不依赖 Redis；公网版必须设置 OSTOOL_REDIS_URL。

# 开发启动脚本 scripts/dev.sh 始终读取本文件，不受当前工作目录影响。
# 进程环境变量或命令前设置的环境变量优先于本文件中的值。
# dev.sh 仅读取 OSTOOL_DEV_*、OSTOOL_EDITION 和初始管理员凭据。
# 上方的部署数据库地址、监听地址、代理与安全配置用于直接启动服务器；
# 开发脚本自行管理独立的内部服务。
# 留空时，本地版监听 0.0.0.0，公网版监听 127.0.0.1。
OSTOOL_DEV_HOST=
# 若本地版仅允许本机回环访问，请设置 OSTOOL_DEV_HOST=127.0.0.1。
OSTOOL_DEV_SERVER_PORT=2999
OSTOOL_DEV_DEMO=true
# 可选开发脚本配置（默认值随版本而异）：
# OSTOOL_DEV_DIR=/absolute/path/to/development-data
# OSTOOL_DEV_PG_PORT=54328
# OSTOOL_DEV_PG_CONTAINER=ostool-server-dev-local-postgres
# OSTOOL_DEV_REDIS_PORT=56380
# OSTOOL_DEV_REDIS_CONTAINER=ostool-server-dev-public-redis
# OSTOOL_DEV_DB_USER=ostool
# OSTOOL_DEV_DB_PASSWORD=ostool
# OSTOOL_DEV_DB_NAME=ostool
