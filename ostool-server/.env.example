# Default local edition. No accounts, login or rental administration.
# The frontend reads the same runtime edition from the Rust server.
OSTOOL_EDITION=local
# Direct server startup only; dev.sh uses OSTOOL_DEV_HOST/OSTOOL_DEV_SERVER_PORT below.
OSTOOL_LISTEN_ADDR=127.0.0.1:2999
OSTOOL_NETWORK_TEST_ENABLED=false
# Both editions use PostgreSQL. Connecting it does NOT enable local authentication.
OSTOOL_DATABASE_URL=postgres://ostool:change-me@127.0.0.1:5432/ostool
# Optional schema (same value in both editions to share data; default search path if omitted).
# OSTOOL_DATABASE_SCHEMA=ostool
# For authenticated public deployment, use deploy/public.env.example instead.
# 0 (default) keeps all audit events; 1..3650 enables hourly retention cleanup.
OSTOOL_AUDIT_RETENTION_DAYS=0
# Only explicitly trusted proxy peers may supply the X-Forwarded-For chain.
# For a local Caddy reverse proxy: 127.0.0.1,::1
OSTOOL_TRUSTED_PROXY_IPS=
# Local edition does not need CAPTCHA, MFA, SMTP or identity/rental configuration.
# Public settings, including optional email verification, are documented in:
# deploy/public.env.example and deploy/security.md

# Local edition has no Redis dependency. Public edition requires OSTOOL_REDIS_URL.

# Development launcher: scripts/dev.sh reads this file regardless of cwd.
# Process/inline environment variables override values in this file.
# Only OSTOOL_DEV_*, OSTOOL_EDITION and bootstrap admin credentials are read
# by dev.sh. Deployment database URLs/listener/proxy/security settings above
# are for direct server startup; the launcher manages its own private services.
# Empty host selects 0.0.0.0 in local edition and 127.0.0.1 in public edition.
OSTOOL_DEV_HOST=
# For loopback-only local access, set OSTOOL_DEV_HOST=127.0.0.1.
OSTOOL_DEV_SERVER_PORT=2999
OSTOOL_DEV_DEMO=true
# Optional launcher overrides (defaults are edition-specific):
# OSTOOL_DEV_DIR=/absolute/path/to/development-data
# OSTOOL_DEV_PG_PORT=54328
# OSTOOL_DEV_PG_CONTAINER=ostool-server-dev-local-postgres
# OSTOOL_DEV_REDIS_PORT=56380
# OSTOOL_DEV_REDIS_CONTAINER=ostool-server-dev-public-redis
# OSTOOL_DEV_DB_USER=ostool
# OSTOOL_DEV_DB_PASSWORD=ostool
# OSTOOL_DEV_DB_NAME=ostool
