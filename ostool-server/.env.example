# local：免登录，无用户/租赁功能；public：完整登录、用户与租赁功能。
# 两种功能版本使用相同 release 镜像、PostgreSQL 数据及安全实现。
OSTOOL_EDITION=local

# Docker Compose 数据库密码。生产环境必须换成长随机值。
# 此值用于连接 URL，请使用字母、数字、下划线或短横线。
OSTOOL_POSTGRES_PASSWORD=change-me
# PostgreSQL 和 Redis 仅映射到宿主回环端口；可按现有服务占用情况调整。
OSTOOL_POSTGRES_PORT=54329
OSTOOL_REDIS_PORT=56380
# 以下连接地址用于直接启动二进制；Compose 根据上方密码和端口组装相同的回环连接地址。
OSTOOL_DATABASE_URL=postgres://ostool:change-me@127.0.0.1:54329/ostool
OSTOOL_REDIS_URL=redis://127.0.0.1:56380/0
OSTOOL_LISTEN_ADDR=127.0.0.1:2999
OSTOOL_NETWORK_TEST_ENABLED=false

# 唯一的主站地址，用于 CLI 授权链接、邮件链接及安全 Cookie。
OSTOOL_PUBLIC_BASE_URL=https://127.0.0.1:3443
# 附加允许访问的来源，逗号分隔，必须与主站使用相同协议，不带路径或末尾斜线。
# 局域网访问时，将实际 IP 加入下面两项，例如：
# OSTOOL_ALLOWED_ORIGINS=https://localhost:3443,https://192.168.20.10:3443
# OSTOOL_SITE_ADDRESSES="https://127.0.0.1 https://localhost https://192.168.20.10"
OSTOOL_ALLOWED_ORIGINS=https://localhost:3443
# Caddy 站点地址用空格分隔。内部 IP 自动使用内部 CA；正式域名自动申请公网证书。
OSTOOL_SITE_ADDRESSES="https://127.0.0.1 https://localhost"
OSTOOL_HTTPS_BIND=0.0.0.0
OSTOOL_HTTPS_PORT=3443
# IP HTTPS 首次启动后用 scripts/dev.sh cert 导出根证书，在访问设备上导入并信任。
# 正式部署设置实际域名与端口 443；systemd 安装使用 scripts/install.sh 和 deploy/Caddyfile.example。

# public 版首次初始化管理员。没有内置默认密码，请自行设置。
# OSTOOL_ADMIN_USERNAME=admin
# OSTOOL_ADMIN_EMAIL=admin@example.com
# OSTOOL_ADMIN_PASSWORD=replace-with-a-long-random-password
# 双重验证密钥仅生成一次，妥善保存；生成命令：openssl rand -base64 32
# OSTOOL_MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# 邮箱验证默认可选，验证码默认启用。其余安全/SMTP 配置见 deploy/public.env.example。
OSTOOL_REGISTRATION_EMAIL_VERIFICATION=false

# 0 表示永久保留审计事件；1..3650 为保留天数。
OSTOOL_AUDIT_RETENTION_DAYS=0
# 与同机 systemd 部署相同，只信任回环地址上的 Caddy。
OSTOOL_TRUSTED_PROXY_IPS=127.0.0.1,::1
